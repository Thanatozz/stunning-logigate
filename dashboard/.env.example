VITE_USE_FIREBASE=true
VITE_VIRTUAL_GATE=false

# Firebase Web App config (Project settings > General > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: secure backend endpoint (Cloud Function) that deletes users in Firebase Auth.
# Example: https://<REGION>-<PROJECT_ID>.cloudfunctions.net/deleteAuthUserByAdmin
VITE_AUTH_ADMIN_DELETE_URL=

# Gate access point id used by dashboard and ESP32 command channel
VITE_ACCESS_POINT=porton_norte

# When true, dashboard updates barrier state directly in RTDB (useful without ESP32)
# Keep false when a physical controller is connected.
# VITE_VIRTUAL_GATE=true
